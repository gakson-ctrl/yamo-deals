# YaMo Deals — Environment Variables
# Copy this file to .env.local and fill in your Supabase project values.
# Never commit .env.local to git.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Demo mode ─────────────────────────────────────────────────────────────────
# Set to "true" to bypass real SMS OTP (accept any 6-digit code)
NEXT_PUBLIC_DEMO_MODE=true

# ── SMS provider (production only) ───────────────────────────────────────────
# Uncomment and fill when Africa's Talking / HelloDuty is confirmed (Flag 🚩1)
# AFRICAS_TALKING_API_KEY=your-key
# AFRICAS_TALKING_USERNAME=your-username
